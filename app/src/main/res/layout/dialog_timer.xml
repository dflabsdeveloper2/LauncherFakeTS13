<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btn_close_timer"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="@string/timer_header"
                android:textColor="@color/environment_unselected_title"
                android:textSize="@dimen/text_size_header_label"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/timer_subtitle"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_header_title"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_close_timer"
            android:layout_width="@dimen/dialog_close_button_size"
            android:layout_height="@dimen/dialog_close_button_size"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_name_selector_close"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/gray_800"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Tiempo restante -->
    <TextView
        android:id="@+id/tv_timer_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:textColor="@color/widget_label_primary"
        android:textSize="@dimen/timer_time_text_size"
        android:textStyle="bold"
        tools:text="10:00" />

    <!-- Presets -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_1min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:background="@drawable/bg_timer_chip_unselected"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:tag="1"
            android:text="1 min"
            android:textColor="@color/gray_800"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_3min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:background="@drawable/bg_timer_chip_unselected"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:tag="3"
            android:text="3 min"
            android:textColor="@color/gray_800"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_5min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:background="@drawable/bg_timer_chip_unselected"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:tag="5"
            android:text="5 min"
            android:textColor="@color/gray_800"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_10min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:background="@drawable/bg_timer_chip_unselected"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:tag="10"
            android:text="10 min"
            android:textColor="@color/gray_800"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_15min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:background="@drawable/bg_timer_chip_unselected"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:tag="15"
            android:text="15 min"
            android:textColor="@color/gray_800"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Ajuste fino -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_minus_30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_timer_chip_outline"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="- 30 S"
            android:textColor="@color/widget_label_primary"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_plus_30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_timer_chip_outline"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="+ 30 S"
            android:textColor="@color/widget_label_primary"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Acciones -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_reset"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_timer_chip_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="@string/btn_reset"
            android:textAllCaps="true"
            android:textColor="@color/widget_label_primary"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_start"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_name_selector_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="@string/btn_start"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
