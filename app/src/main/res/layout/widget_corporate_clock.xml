<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center">

    <TextClock
        android:id="@+id/tv_corp_clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="@color/widget_label_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextClock
        android:id="@+id/tv_corp_clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEE · dd MMM"
        android:format24Hour="EEE · dd MMM"
        android:textColor="@color/widget_label_secondary"
        android:textSize="8sp"
        android:textAllCaps="true" />

</LinearLayout>
