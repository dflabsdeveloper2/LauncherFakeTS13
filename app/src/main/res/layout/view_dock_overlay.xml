<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:elevation="8dp">

    <!-- Panel del dock (colapsable) -->
    <HorizontalScrollView
        android:id="@+id/dock_panel"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:visibility="visible"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_dock"
            android:paddingHorizontal="12dp">

            <LinearLayout
                android:layout_width="55dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginEnd="8dp"
                android:gravity="center">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/orbys_logo"
                    android:textColor="@color/dock_logo_color"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:background="@color/dock_divider"
                android:layout_marginHorizontal="4dp" />

            <!-- Back -->
            <LinearLayout
                android:id="@+id/tab_back"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp">
                <ImageView
                    android:id="@+id/ic_tab_back"
                    android:layout_width="20dp"
                    android:layout_height="20dp" android:src="@drawable/fl15"
                    android:contentDescription="@string/dock_back" />
                <TextView
                    android:id="@+id/lbl_tab_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/dock_back"
                    android:textColor="@color/dock_text_inactive"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Home -->
            <LinearLayout
                android:id="@+id/tab_home"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp">
                <ImageView
                    android:id="@+id/ic_tab_home"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/home"
                    app:tint="@color/dock_text_inactive"
                    android:contentDescription="@string/dock_home" />
                <TextView
                    android:id="@+id/lbl_tab_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/dock_home"
                    android:textColor="@color/dock_text_inactive"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Recents -->
            <LinearLayout
                android:id="@+id/tab_recents"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp">
                <ImageView
                    android:id="@+id/ic_tab_recents"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/backgroundapps"
                    app:tint="@color/dock_text_inactive"
                    android:contentDescription="@string/dock_recents" />
                <TextView
                    android:id="@+id/lbl_tab_recents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dock_recents"
                    android:textColor="@color/dock_text_inactive"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Apps -->
            <LinearLayout
                android:id="@+id/tab_apps"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp">
                <ImageView
                    android:id="@+id/ic_tab_apps"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:padding="2dp"
                    android:src="@drawable/bottombar_apps"
                    android:contentDescription="@string/dock_apps" />
                <TextView
                    android:id="@+id/lbl_tab_apps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/dock_apps"
                    android:textColor="@color/dock_text_inactive"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Files -->
            <LinearLayout
                android:id="@+id/tab_files"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp">
                <ImageView
                    android:id="@+id/ic_tab_files"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:padding="2dp"
                    android:src="@drawable/bottombar_filesmanager"
                    android:contentDescription="@string/dock_files" />
                <TextView
                    android:id="@+id/lbl_tab_files"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/dock_files"
                    android:textColor="@color/dock_text_inactive"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Pizarra -->
            <LinearLayout
                android:id="@+id/tab_pizarra"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp">
                <ImageView
                    android:id="@+id/ic_tab_pizarra"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:padding="1dp"
                    android:src="@drawable/bottombar_whiteboard"
                    app:tint="@color/dock_text_inactive"
                    android:contentDescription="@string/dock_pizarra" />
                <TextView
                    android:id="@+id/lbl_tab_pizarra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/dock_pizarra"
                    android:textColor="@color/dock_text_inactive"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Browser -->
            <LinearLayout
                android:id="@+id/tab_browser"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp">
                <ImageView
                    android:id="@+id/ic_tab_browser"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:padding="2dp"
                    android:src="@drawable/bottombar_browser2"
                    app:tint="@color/dock_text_inactive"
                    android:contentDescription="@string/dock_browser" />
                <TextView
                    android:id="@+id/lbl_tab_browser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/dock_browser"
                    android:textColor="@color/dock_text_inactive"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Settings -->
            <LinearLayout
                android:id="@+id/tab_settings"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp">
                <ImageView
                    android:id="@+id/ic_tab_settings"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/bottombar_settings"
                    app:tint="@color/dock_text_inactive"
                    android:contentDescription="@string/dock_settings" />
                <TextView
                    android:id="@+id/lbl_tab_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dock_settings"
                    android:textColor="@color/dock_text_inactive"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:background="@color/dock_divider"
                android:layout_marginHorizontal="4dp" />

            <!-- Reloj -->
            <LinearLayout
                android:layout_width="55dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <TextClock
                    android:id="@+id/tv_dock_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="@color/blue2_50_100"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextClock
                    android:id="@+id/tv_dock_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="d MMM"
                    android:format24Hour="d MMM"
                    android:textAllCaps="true"
                    android:textColor="@color/dock_text_inactive"
                    android:textSize="9sp" />
            </LinearLayout>

           <!-- <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:background="@color/dock_divider"
                android:layout_marginHorizontal="4dp" />

            &lt;!&ndash; Botón minimizar dock &ndash;&gt;
            <LinearLayout
                android:id="@+id/btn_dock_minimize"
                android:layout_width="40dp"
                android:layout_height="52dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="1dp">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/fl33"
                    android:rotation="-90"
                    android:contentDescription="Minimizar dock"
                    app:tint="@color/dock_text_inactive" />
            </LinearLayout>-->

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Handle: solo visible cuando el dock está colapsado, pegado al borde inferior -->
    <FrameLayout
        android:id="@+id/dock_toggle_handle"
        android:layout_width="70dp"
        android:layout_height="16dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="12dp">
        <View
            android:layout_width="25dp"
            android:layout_height="3dp"
            android:layout_gravity="center" />
    </FrameLayout>

</LinearLayout>