<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/dialog_padding"
    android:background="@drawable/bg_dialog_rounded">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/clock_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/config_panel_title"
            android:textColor="@color/environment_unselected_title"
            android:textSize="@dimen/text_size_header_label"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/btn_close_clock_x"
            android:layout_width="@dimen/dialog_close_button_size"
            android:layout_height="@dimen/dialog_close_button_size"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_name_selector_close"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/gray_800"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <TextClock
        android:id="@+id/tc_large_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="@color/black"
        android:textSize="100sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:letterSpacing="-0.02"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/clock_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextClock
        android:id="@+id/tc_large_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEEE, d 'de' MMMM"
        android:format24Hour="EEEE, d 'de' MMMM"
        android:textColor="@color/dock_text_inactive"
        android:textSize="18sp"
        android:textAllCaps="true"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tc_large_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
