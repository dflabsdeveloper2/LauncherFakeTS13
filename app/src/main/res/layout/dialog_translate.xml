<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btn_close_translate"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="//ORBYS TRANSLATE"
                android:textColor="#1A2363"
                android:textSize="@dimen/text_size_header_label"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Traducción en vivo"
                android:textColor="#000000"
                android:textSize="@dimen/text_size_header_title"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_close_translate"
            android:layout_width="@dimen/dialog_close_button_size"
            android:layout_height="@dimen/dialog_close_button_size"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_name_selector_close"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="#5F6368"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Selector de idiomas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_lang_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_timer_chip_unselected"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:text="Español  ▾"
            android:textColor="#1A1A2E"
            android:textSize="@dimen/text_size_body_secondary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_swap_languages"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_name_selector_icon_box"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⇄"
            android:textColor="#1A4479"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_lang_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_timer_chip_unselected"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:text="Inglés  ▾"
            android:textColor="#1A1A2E"
            android:textSize="@dimen/text_size_body_secondary"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_start_translate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_name_selector_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            android:paddingBottom="6dp"
            android:text="🌐 TRADUCIR"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_size_body_secondary"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Paneles de traducción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_translate_source"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_translate_source_panel"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="12dp"
            android:text="Buenos días, hoy vamos a repasar las fracciones y a resolver un reto en equipo."
            android:textColor="#1A1A2E"
            android:textColorHint="#9AA0A6"
            android:textCursorDrawable="@null"
            android:textSize="@dimen/text_size_body_secondary" />

        <TextView
            android:id="@+id/tv_translate_target"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_translate_target_panel"
            android:padding="12dp"
            android:text="Good morning, today we are going to review fractions and solve a team challenge."
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_size_body_secondary" />

    </LinearLayout>

    <!-- Frases rápidas -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_timer_chip_unselected"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="Buenos días, vamos a empezar."
                android:textColor="#1A1A2E"
                android:textSize="@dimen/text_size_footer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_timer_chip_unselected"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="Abrid el libro por la página 24."
                android:textColor="#1A1A2E"
                android:textSize="@dimen/text_size_footer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_timer_chip_unselected"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="Trabajad en parejas, por favor."
                android:textColor="#1A1A2E"
                android:textSize="@dimen/text_size_footer" />

        </LinearLayout>

    </HorizontalScrollView>

</LinearLayout>
