<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_fake_google">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_header_fake_google"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/google_calendar_svgrepo_com"
                android:background="@drawable/bg_calendar_icon_fake_google"
                android:padding="6dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Google Calendar"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Requiere iniciar sesión"
                    android:textColor="#D9E8FF"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_close_fake_google"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            android:contentDescription="Cerrar"
            app:tint="@android:color/white"/>

    </RelativeLayout>

    <!-- Contenido -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/ic_ms_security"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Inicia sesión para usar Google Calendar"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#1F2937" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Esta app necesita una cuenta validada en este panel."
            android:textSize="15sp"
            android:textColor="#94A3B8" />

        <Button
            android:id="@+id/btnValidate"
            android:layout_width="260dp"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:text="VALIDAR CUENTA"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textAllCaps="true"
            android:background="@drawable/bg_button_fake_google"
            android:textColor="@android:color/white"/>

    </LinearLayout>

</LinearLayout>
