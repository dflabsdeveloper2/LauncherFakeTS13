<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_fake_google">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_header_fake_google"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_google_calendar"
                android:background="@drawable/bg_calendar_icon_fake_google"
                android:padding="6dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/google_calendar_title"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_required_subtitle"
                    android:textColor="#D9E8FF"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_close_fake_google"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:contentDescription="Cerrar"
            app:tint="@android:color/white"/>

    </RelativeLayout>

    <!-- Contenido -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:layout_width="@dimen/google_calendar_lock_icon_size"
            android:layout_height="@dimen/google_calendar_lock_icon_size"
            android:src="@drawable/ic_ms_security"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/login_to_use_google_calendar"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#1F2937" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/account_validation_needed"
            android:textSize="13sp"
            android:textColor="#94A3B8" />

        <Button
            android:id="@+id/btnValidate"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="@string/btn_validate_account"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textAllCaps="true"
            android:background="@drawable/bg_button_fake_google"
            android:textColor="@android:color/white"/>

    </LinearLayout>

</LinearLayout>
