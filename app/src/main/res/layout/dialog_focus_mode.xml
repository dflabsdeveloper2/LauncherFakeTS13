<?xml version="1.0" encoding="utf-8"?>
<!--
    Diálogo de pantalla completa "Modo Concentración".

    Autocontenido a propósito: todos los colores van hardcodeados aquí (no
    usan colors.xml del proyecto), para que este layout + FocusModeDialog.kt
    + el drawable bg_focus_exit_button se puedan copiar tal cual a otro
    proyecto.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080C16">

    <TextView
        android:id="@+id/tv_focus_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:fontFamily="sans-serif-light"
        android:textColor="#FFFFFF"
        android:textSize="56sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="11:13" />

    <TextView
        android:id="@+id/tv_focus_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:letterSpacing="0.15"
        android:text="MODO CONCENTRACIÓN"
        android:textColor="#5F6B80"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_focus_clock" />

    <LinearLayout
        android:id="@+id/group_focus_meter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.48">

        <LinearLayout
            android:id="@+id/ll_focus_bars"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:gravity="bottom"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_focus_db_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#7DEDD0"
                android:textSize="48sp"
                android:textStyle="bold"
                tools:text="41" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:text="dB"
                android:textColor="#7DEDD0"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_focus_db_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.1"
            android:textColor="#5F6B80"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="AMBIENTE TRANQUILO" />

    </LinearLayout>

    <TextView
        android:id="@+id/btn_exit_focus_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_focus_exit_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="28dp"
        android:paddingBottom="14dp"
        android:text="✕  SALIR DEL MODO CONCENTRACIÓN"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
