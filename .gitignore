# --- Android Expert .gitignore ---

# Gradle files
.gradle/
build/
/*/build/

# Kotlin / Java
*.class
*.pyc

# IDE - IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws
out/

# Local configuration (SDK path, etc.)
local.properties

# Log files
*.log

# Keystore files (NEVER commit these)
*.jks
*.keystore
*.p12

# Google Services
#google-services.json

# Screenshots and captures
/captures/
*.hprof

# OS generated files
.DS_Store
Thumbs.db

# --- AI and Artifacts Exclusions ---
# Exclude the artifacts directory and all .md files generated by AI assistants
.artifacts/
*.artifact.md
implementation_plan.md
task.md
walkthrough.md
/scratch/

# Backup files
*.bak
*.swp
